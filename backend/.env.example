# ─────────────────────────────────────────────────────────────────────
# SkyCast backend environment
# Copy this file to  backend/.env  and fill in real values.
#   cp backend/.env.example backend/.env
# `.env` is git-ignored — NEVER commit real keys.
# ─────────────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# ── Weather providers (server-side only — never exposed to the browser) ──
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Optional overrides (sensible defaults baked into the code when unset)
# OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
# OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
# REVERSE_GEO_BASE_URL=https://api.bigdatacloud.net/data/reverse-geocode-client

# ── Limits & cache (defaults shown) ──────────────────────────────────
# RATE_LIMIT_PER_MINUTE=60
# CACHE_CURRENT_TTL_SECONDS=600
# CACHE_FORECAST_TTL_SECONDS=3600
# CACHE_GEOCODE_TTL_SECONDS=86400
